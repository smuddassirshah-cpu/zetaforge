# Copy to .env and fill in. Never commit .env.
# Loaded exclusively by orchestrate/ (PLAN.md section 7).

# Cloud provider: aws | gcp | lambda
ZETAFORGE_CLOUD_PROVIDER=aws

# Object store for transcripts, checkpoints, and certificates
ZETAFORGE_STATE_BUCKET=
ZETAFORGE_STATE_REGION=eu-west-2

# Provider credentials (least-privilege; scope documented in docs/DECISIONS.md)
# AWS path
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# GCP path (keyfile lives OUTSIDE the repo; never commit it)
ZETAFORGE_GCP_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

# Lambda (Lambda Labs) path
ZETAFORGE_LAMBDA_API_KEY=

# Environment separation
ZETAFORGE_PROFILE=dev
